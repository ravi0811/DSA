def binarySearch(num,target):
    left,right=0,len(num)-1
    while left<= right:
        mid= (left+right)//2
        if num[mid]==target:
            return mid
        elif num[mid]<target:
            left=mid+1
        else:
            right=mid-1
    return -1


num_list = [1, 8, 10, 12, 15, 16]
target_value = 17

print(binarySearch(num_list,target_value))
